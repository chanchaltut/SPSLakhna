2:T5fc,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Where is Swagat Public School located?","acceptedAnswer":{"@type":"Answer","text":"Swagat Public School is located in Lakhna, Nuapada district, Odisha 766105, India. Directions are available on the Contact page."}},{"@type":"Question","name":"Which classes does Swagat Public School offer?","acceptedAnswer":{"@type":"Answer","text":"The school offers Nursery, LKG and UKG in the Early Years programme and Class 1 to Class 5 in the Primary Years programme."}},{"@type":"Question","name":"What is the admission age for Nursery?","acceptedAnswer":{"@type":"Answer","text":"Children aged 3 to 4 years are admitted to Nursery. LKG is for ages 4 to 5 and UKG is for ages 5 to 6."}},{"@type":"Question","name":"How do I apply for admission at SPS Lakhna?","acceptedAnswer":{"@type":"Answer","text":"Fill in the online application form on the Admissions page, then visit the school to meet the teachers. You can also call +91 98765 43210 or email contact@spslakhna.in."}},{"@type":"Question","name":"What are the school timings?","acceptedAnswer":{"@type":"Answer","text":"The school is open Monday to Saturday from 8:00 AM to 2:00 PM. Early Years classes finish at 12:00 PM. The school is closed on Sundays."}},{"@type":"Question","name":"How can I contact Swagat Public School, Lakhna?","acceptedAnswer":{"@type":"Answer","text":"Call +91 98765 43210, email contact@spslakhna.in, or send a message through the Contact page of spslakhna.in."}}]}6:T6ea,{"@context":"https://schema.org","@graph":[{"@type":["School","Preschool","ElementarySchool"],"@id":"https://spslakhna.in/#school","name":"Swagat Public School","alternateName":["SPS Lakhna","Swagat Public School, Lakhna","SPS"],"slogan":"Where Every Child is Welcome","description":"Swagat Public School (SPS Lakhna) is a kindergarten and primary school in Lakhna, Nuapada district, Odisha, offering caring, activity-based education from Nursery to Clas